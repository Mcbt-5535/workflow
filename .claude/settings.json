{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "WF_ALLOW_AUTO_COMMIT": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git show:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(cat .claude/**)",
      "Bash(grep:*)",
      "Read(./**)",
      "Write(.claude/workflow/plans/**)",
      "Write(.claude/workflow/summaries/**)",
      "Write(.claude/workflow/archive/**)",
      "Edit(.claude/workflow/plans/**)",
      "Edit(.claude/workflow/summaries/**)",
      "Edit(.claude/workflow/archive/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$WF_ALLOW_AUTO_COMMIT\" != \"true\" ]; then echo '{\"systemMessage\":\"Auto-commit is disabled. Set WF_ALLOW_AUTO_COMMIT=true to enable.\",\"continue\":false,\"stopReason\":\"Git commit blocked: WF_ALLOW_AUTO_COMMIT is false\"}'; else echo '{\"continue\":true}'; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/wf-session-start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/wf-post-tool.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/wf-stop.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/wf-session-end.sh" }
        ]
      }
    ]
  }
}
