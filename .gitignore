# Workflow runtime data (generated by /wf-plan, /wf-dev, /wf-checkpoint)
# These directories contain ephemeral artifacts; only README.md placeholders are tracked.
.claude/workflow/plans/*
!.claude/workflow/plans/README.md
.claude/workflow/summaries/*
!.claude/workflow/summaries/README.md
.claude/workflow/archive/*
!.claude/workflow/archive/README.md

# Per-machine configuration
.claude/settings.local.json

temp/*
